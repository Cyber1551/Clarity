{
  "identifier": "app",
  "description": "used for all windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-watch",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "ffprobe",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": ["**", "**/*", "**/.*", "**/.*/**"]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": ["**", "**/*", "**/.*", "**/.*/**"]
    }
  ]
}
