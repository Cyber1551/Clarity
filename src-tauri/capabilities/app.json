{
  "identifier": "app",
  "description": "used for all windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "ffprobe",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
